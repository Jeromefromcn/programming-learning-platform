# Copy to .env and fill in values before running docker compose up
DB_URL=jdbc:mysql://mysql:3306/exercise_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=platform
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root
JWT_SECRET=change-this-to-a-minimum-32-character-random-secret-string
GRAFANA_ADMIN_PASSWORD=changeme
# Public URL where this Grafana instance is reachable (used to build correct
# Source/Silence links in alert notifications) — include the port, e.g. :3001
GRAFANA_ROOT_URL=http://your-server-host:3001
MYSQL_HOST=mysql
MYSQL_DATABASE=exercise_db
BACKUP_DIR=/var/backups/exercise-platform

# Prometheus basic auth — protects the exposed :9090 UI/API.
# PROMETHEUS_BASIC_AUTH_PASSWORD is the plaintext password (used by Grafana's
# datasource to authenticate); PROMETHEUS_BASIC_AUTH_HASH is its bcrypt hash
# (used by Prometheus itself, via monitoring/prometheus/web.yml.tmpl).
# Generate a matching pair with:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin '<your-password>'
PROMETHEUS_BASIC_AUTH_USER=admin
PROMETHEUS_BASIC_AUTH_PASSWORD=changeme
PROMETHEUS_BASIC_AUTH_HASH=$2y$05$replace-with-generated-bcrypt-hash

# Telegram alerts (optional) — fill in to enable Grafana alert notifications
# Create a bot via @BotFather, add it to your group, then set the chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=